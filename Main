npm install
npm install firebase lucide-react
npm install -D tailwindcss @tailwindcss/viteimport { initializeApp } from "firebase/app";
import { getAuth } from "firebase/auth";
import { getFirestore } from "firebase/firestore";

const firebaseConfig = {
  apiKey: import.meta.env.VITE_FIREBASE_API_KEY,
  authDomain: import.meta.env.VITE_FIREBASE_AUTH_DOMAIN,
  projectId: import.meta.env.VITE_FIREBASE_PROJECT_ID,
  storageBucket: import.meta.env.VITE_FIREBASE_STORAGE_BUCKET,
  messagingSenderId: import.meta.env.VITE_FIREBASE_MESSAGING_SENDER_ID,
  appId: import.meta.env.VITE_FIREBASE_APP_ID,
};

const app = initializeApp(firebaseConfig);

export const auth = getAuth(app);
export const db = getFirestore(app);import { useState } from "react";
import {
  createUserWithEmailAndPassword,
  updateProfile,
} from "firebase/auth";
import { doc, setDoc } from "firebase/firestore";
import {
  Eye,
  EyeOff,
  Wallet,
  TrendingUp,
  Users,
  LogOut,
} from "lucide-react";
import { auth, db } from "./firebase";
import "./App.css";

const countries = [
  { name: "Kenya", code: "+254" },
  { name: "Uganda", code: "+256" },
  { name: "Tanzania", code: "+255" },
  { name: "United States", code: "+1" },
  { name: "United Kingdom", code: "+44" },
  { name: "Nigeria", code: "+234" },
  { name: "South Africa", code: "+27" },
];

export default function App() {
  const [showPassword, setShowPassword] = useState(false);
  const [registered, setRegistered] = useState(false);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [form, setForm] = useState({
    fullName: "",
    countryCode: "+254",
    phone: "",
    email: "",
    password: "",
    referralCode: "",
  });

  const update = (e) =>
    setForm({ ...form, [e.target.name]: e.target.value });

  async function register(e) {
    e.preventDefault();
    setError("");

    if (!form.fullName.trim() || !form.phone.trim() || !form.email.trim()) {
      setError("Please complete all required fields.");
      return;
    }

    if (form.password.length < 6) {
      setError("Your password must contain at least 6 characters.");
      return;
    }

    setLoading(true);

    try {
      const credential = await createUserWithEmailAndPassword(
        auth,
        form.email.trim(),
        form.password
      );

      await updateProfile(credential.user, {
        displayName: form.fullName.trim(),
      });

      await setDoc(doc(db, "users", credential.user.uid), {
        fullName: form.fullName.trim(),
        phone: `${form.countryCode}${form.phone.trim()}`,
        email: form.email.trim(),
        referralCode: form.referralCode.trim() || null,
        createdAt: new Date().toISOString(),
        accountStatus: "active",
      });

      setRegistered(true);
    } catch (err) {
      setError(
        err.code === "auth/email-already-in-use"
          ? "This email is already registered."
          : err.code === "auth/weak-password"
          ? "Please choose a stronger password."
          : "Registration failed. Check your details and try again."
      );
    } finally {
      setLoading(false);
    }
  }

  if (registered) {
    return (
      <main className="dashboard">
        <header className="topbar">
          <div className="brand">
            <TrendingUp size={25} />
            <span>Investment Portal</span>
          </div>
          <button
            className="logout"
            onClick={() => auth.signOut().then(() => setRegistered(false))}
          >
            <LogOut size={18} /> Sign out
          </button>
        </header>

        <section className="welcome">
          <p>WELCOME BACK</p>
          <h1>{form.fullName}</h1>
          <p>Your account dashboard</p>
        </section>

        <section className="balance-card">
          <p>Demo investment balance</p>
          <h2>$0.00</h2>
          <span>Real deposits are not enabled.</span>
        </section>

        <section className="stats">
          <article className="stat-card">
            <Wallet />
            <p>Minimum plan</p>
            <h3>$294</h3>
          </article>

          <article className="stat-card">
            <TrendingUp />
            <p>Proposed daily return</p>
            <h3>$3</h3>
            <small>Illustrative only; not guaranteed.</small>
          </article>

          <article className="stat-card">
            <Users />
            <p>Referral code</p>
            <h3>{form.referralCode || "Not provided"}</h3>
          </article>
        </section>

        <section className="notice">
          <h3>Investment information</h3>
          <p>
            This is a demonstration dashboard. No money has been deposited,
            and no actual investment or earnings are recorded.
          </p>
        </section>
      </main>
    );
  }

  return (
    <main className="page">
      <section className="form-card">
        <div className="logo">
          <TrendingUp size={32} />
        </div>

        <h1>Create Account</h1>
        <p className="subtitle">
          Register to access your investment dashboard.
        </p>

        {error && <div className="error">{error}</div>}

        <form onSubmit={register}>
          <label>Full Names</label>
          <input
            name="fullName"
            placeholder="Enter your full legal name"
            value={form.fullName}
            onChange={update}
            autoComplete="name"
            required
          />

          <label>Email Address</label>
          <input
            name="email"
            type="email"
            placeholder="Enter your email address"
            value={form.email}
            onChange={update}
            autoComplete="email"
            required
          />

          <label>Phone Number</label>
          <div className="phone-row">
            <select
              name="countryCode"
              value={form.countryCode}
              onChange={update}
              aria-label="Country calling code"
            >
              {countries.map((country) => (
                <option key={country.code} value={country.code}>
                  {country.name} ({country.code})
                </option>
              ))}
            </select>

            <input
              name="phone"
              type="tel"
              placeholder="Phone number"
              value={form.phone}
              onChange={update}
              autoComplete="tel-national"
              required
            />
          </div>

          <label>Password</label>
          <div className="password-row">
            <input
              name="password"
              type={showPassword ? "text" : "password"}
              placeholder="Create a password"
              value={form.password}
              onChange={update}
              autoComplete="new-password"
              minLength={6}
              required
            />
            <button
              type="button"
              className="eye-button"
              onClick={() => setShowPassword(!showPassword)}
              aria-label={showPassword ? "Hide password" : "Show password"}
            >
              {showPassword ? <EyeOff size={20} /> : <Eye size={20} />}
            </button>
          </div>

          <label>Referral Code (Optional)</label>
          <input
            name="referralCode"
            placeholder="Enter referral code"
            value={form.referralCode}
            onChange={update}
          />

          <button className="primary-button" disabled={loading}>
            {loading ? "Creating account..." : "Create Account"}
          </button>
        </form>

        <p className="footer-text">
          Already registered? Sign in through your account authentication flow.
        </p>

        <p className="disclaimer">
          Demonstration interface only. No real deposits or guaranteed returns.
          This app is not affiliated with Binance.
        </p>
      </section>
    </main>
  );
}@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap");

